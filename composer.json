{
    "name": "rpkamp/mailhog-mink-behat-context",
    "description": "Mailhog Extension for Behat",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Remon van de Kamp",
            "email": "rpkamp@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "rpkamp\\Behat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "rpkamp\\Behat\\MailhogExtension\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^7.4 || ^8.0",
        "friends-of-behat/mink-extension": "^2.7",
        "rpkamp/mailhog-behat-extension": "^1.0.0",
        "symfony/dom-crawler": "^5.4.52 || ^6.4.40 || ^7.4.12"
    },
    "require-dev": {
        "php-http/curl-client": "^2.0",
        "rpkamp/mailhog-client": "^1.0.3 || ^2.0",
        "symfony/mailer": "^5.4.52 || ^6.0 || ^7.0",
        "squizlabs/php_codesniffer": "^3.13.6",
        "behat/mink-browserkit-driver": "^2.0",
        "symfony/http-client": "^5.4.53 || ^6.4.15 || ^7.1.8",
        "phpstan/phpstan": "^1.1",
        "guzzlehttp/guzzle": "^7.15.2",
        "doctrine/coding-standard": "^8.0",
        "php-parallel-lint/php-parallel-lint": "^1.2",
        "nyholm/psr7": "^1.6.1",
        "phpmd/phpmd": "^2.9"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
